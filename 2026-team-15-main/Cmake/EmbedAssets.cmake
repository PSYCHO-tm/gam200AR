# embed_assets(<output .hpp> <repo-relative file> [<repo-relative file> ...])
#
# Bakes text files (Equipment.json, .obj models) into one generated C++ header, at configure time, so C++ needs no
# file loading at runtime (on Android the Assets folder is packed inside the APK and fopen cannot open it).
#
# The header holds a table: path -> file text. C++ looks a file up by the same repo-relative path, e.g.
# "Assets/Models/kettle.obj". The header is only rewritten when its content changes, so an unchanged sync does not
# trigger a rebuild. Uses REPO_ROOT, which the calling CMakeLists.txt defines.
function(embed_assets OUTPUT)
    set(CONTENT "// Generated by embed_assets (Cmake/EmbedAssets.cmake). Do not edit: edit the source files instead.\n")
    string(APPEND CONTENT "#pragma once\n")
    string(APPEND CONTENT "struct EmbeddedAsset { const char* path; const char* text; };\n")
    string(APPEND CONTENT "inline constexpr EmbeddedAsset gEmbeddedAssets[] = {\n")
    foreach(ASSET ${ARGN})
        if(NOT EXISTS "${REPO_ROOT}/${ASSET}")
            message(FATAL_ERROR "embed_assets: file not found: ${REPO_ROOT}/${ASSET}")
        endif()
        file(READ "${REPO_ROOT}/${ASSET}" TEXT)
        string(APPEND CONTENT "    { \"${ASSET}\", R\"KOPI(${TEXT})KOPI\" },\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${REPO_ROOT}/${ASSET}")
    endforeach()
    string(APPEND CONTENT "};\n")
    string(APPEND CONTENT "inline constexpr int gEmbeddedAssetCount = sizeof(gEmbeddedAssets) / sizeof(gEmbeddedAssets[0]);\n")

    set(OLD "")
    if(EXISTS "${OUTPUT}")
        file(READ "${OUTPUT}" OLD)
    endif()
    if(NOT OLD STREQUAL CONTENT)
        file(WRITE "${OUTPUT}" "${CONTENT}")
    endif()
endfunction()
